# Copie este arquivo para .env.local para usar o Supabase local.
# A URL e a chave pública são exibidas por: npm run db:status
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Cole somente a chave Publishable ou anon; deixe vazio para usar sem histórico.
# Chaves Secret e service_role não devem ser usadas no frontend.
VITE_SUPABASE_ANON_KEY=
